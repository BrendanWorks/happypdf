# Copy to .env and fill in real values. Never commit .env — it's gitignored.

# Modal (required — olmOCR extraction and Qwen2-VL alt-text run as remote
# Modal GPU functions regardless of deployment mode). Get these from
# https://modal.com/settings/tokens, or run `modal token new` locally and
# copy the values out of ~/.modal.toml.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Reviewer / judge credentials (required for the hosted default; these are
# the keys BYOK users override per-job instead of supplying their own).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
